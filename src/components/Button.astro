---
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'accent';
  size?: 'md' | 'lg';
  icon?: boolean;
  magnetic?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon = true,
  magnetic = false,
  class: className,
  ...rest
} = Astro.props;

const label = await Astro.slots.render('default');
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  data-magnetic={magnetic ? '' : undefined}
  {...rest}
>
  <span class="btn__label">
    <span class="btn__text" set:html={label} />
    <span class="btn__text btn__text--clone" aria-hidden="true" set:html={label} />
  </span>
  {
    icon && (
      <span class="btn__icon" aria-hidden="true">
        <ArrowUpRight size={18} stroke-width={2} />
      </span>
    )
  }
</a>

<style>
  .btn {
    --btn-bg: var(--c-ink);
    --btn-fg: var(--c-bg-raised);
    --btn-fill: var(--c-accent);
    --btn-fill-fg: var(--c-ink);
    --btn-icon-bg: var(--c-accent);
    --btn-icon-fg: var(--c-ink);

    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem 0.5rem 0.5rem 1.4rem;
    min-height: 3.2rem;
    border-radius: var(--r-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.005em;
    overflow: hidden;
    transition:
      color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
    will-change: transform;
  }

  /* Liquid fill that rises from below on hover */
  .btn::before {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: -1;
    background: var(--btn-fill);
    border-radius: 50% 50% 0 0 / 60% 60% 0 0;
    transform: translateY(102%);
    transition:
      transform 0.6s var(--ease-out),
      border-radius 0.6s var(--ease-out);
  }

  .btn:hover::before,
  .btn:focus-visible::before {
    transform: translateY(0);
    border-radius: 0;
  }

  .btn:hover,
  .btn:focus-visible {
    color: var(--btn-fill-fg);
    box-shadow: var(--shadow-md);
  }

  /* Rolling label */
  .btn__label {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 1.3;
  }

  .btn__text {
    display: block;
    transition: transform 0.55s var(--ease-out);
  }

  .btn__text--clone {
    position: absolute;
    inset: 0;
    transform: translateY(110%);
  }

  .btn:hover .btn__text,
  .btn:focus-visible .btn__text {
    transform: translateY(-110%);
  }

  .btn:hover .btn__text--clone,
  .btn:focus-visible .btn__text--clone {
    transform: translateY(0);
  }

  .btn__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--btn-icon-bg);
    color: var(--btn-icon-fg);
    flex: none;
    transition:
      transform 0.55s var(--ease-out),
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .btn:hover .btn__icon,
  .btn:focus-visible .btn__icon {
    transform: rotate(45deg);
    background: var(--c-ink);
    color: var(--c-bg-raised);
  }

  /* Variants */
  .btn--outline {
    --btn-bg: transparent;
    --btn-fg: var(--c-ink);
    --btn-fill: var(--c-ink);
    --btn-fill-fg: var(--c-bg-raised);
    --btn-icon-bg: var(--c-ink);
    --btn-icon-fg: var(--c-bg-raised);
    box-shadow: inset 0 0 0 1.5px var(--c-ink);
  }

  .btn--outline:hover .btn__icon,
  .btn--outline:focus-visible .btn__icon {
    background: var(--c-accent);
    color: var(--c-ink);
  }

  .btn--accent {
    --btn-bg: var(--c-accent);
    --btn-fg: var(--c-ink);
    --btn-fill: var(--c-ink);
    --btn-fill-fg: var(--c-bg-raised);
    --btn-icon-bg: var(--c-ink);
    --btn-icon-fg: var(--c-bg-raised);
  }

  .btn--accent:hover .btn__icon,
  .btn--accent:focus-visible .btn__icon {
    background: var(--c-accent);
    color: var(--c-ink);
  }

  .btn--lg {
    min-height: 4rem;
    padding: 0.6rem 0.6rem 0.6rem 1.9rem;
    font-size: 1.12rem;
    gap: 1.2rem;
  }

  .btn--lg .btn__icon {
    width: 2.9rem;
    height: 2.9rem;
  }

  .btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .btn--lg :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
</style>
