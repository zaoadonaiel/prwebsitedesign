---
interface Props {
  class?: string;
  size?: 'md' | 'lg';
}
const { class: className, size = 'md' } = Astro.props;
---

<a href="/#top" class:list={['logo', `logo--${size}`, className]} aria-label="PR Website Design — home">
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="11" fill="currentColor"></rect>
    <path
      class="logo__p"
      d="M13 29.5V11h8.2a6 6 0 0 1 0 12H13"
      fill="none"
      stroke="var(--c-bg)"
      stroke-width="4"
      stroke-linejoin="round"></path>
    <path class="logo__leg" d="M21 23l7.5 7.5" fill="none" stroke="var(--c-accent)" stroke-width="4" stroke-linecap="round"
    ></path>
  </svg>
  <span class="logo__word">
    <strong>PR</strong> Website<span class="logo__design">Design</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--c-ink);
    line-height: 1;
  }

  .logo__mark {
    width: 2.3rem;
    height: 2.3rem;
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }

  .logo__leg {
    transform-origin: 21px 23px;
    transition: transform var(--dur) var(--ease-out);
  }

  .logo:hover .logo__mark {
    transform: rotate(-8deg);
  }

  .logo:hover .logo__leg {
    transform: scale(1.18);
  }

  .logo__word {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    font-family: var(--f-display);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .logo__word strong {
    font-weight: 750;
  }

  .logo__design {
    color: var(--c-muted);
    font-weight: 400;
  }

  .logo--lg .logo__mark {
    width: 3rem;
    height: 3rem;
  }

  .logo--lg .logo__word {
    font-size: 1.4rem;
  }
</style>
