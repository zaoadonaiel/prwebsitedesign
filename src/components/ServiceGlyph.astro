---
import type { ServiceGlyph } from '../data/site';

interface Props {
  name: ServiceGlyph;
}
const { name } = Astro.props;
---

<svg class:list={['glyph', `glyph--${name}`]} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  {
    name === 'design' && (
      <>
        <path class="g-stroke" d="M10 46C18 20 44 44 54 16" />
        <line class="g-thin g-handle" x1="10" y1="46" x2="24" y2="30" />
        <line class="g-thin g-handle" x1="54" y1="16" x2="40" y2="32" />
        <rect class="g-fill-ink g-knob" x="7" y="43" width="6" height="6" />
        <rect class="g-fill-ink g-knob" x="51" y="13" width="6" height="6" />
        <circle class="g-fill-accent g-knob g-knob--a" cx="24" cy="30" r="3.5" />
        <circle class="g-fill-accent g-knob g-knob--b" cx="40" cy="32" r="3.5" />
      </>
    )
  }
  {
    name === 'develop' && (
      <>
        <path class="g-stroke g-left" d="M22 20 10 32l12 12" />
        <path class="g-stroke g-right" d="M42 20l12 12-12 12" />
        <path class="g-stroke g-slash" d="M36 16 28 48" />
        <rect class="g-fill-accent g-caret" x="44" y="46" width="8" height="3" />
      </>
    )
  }
  {
    name === 'wordpress' && (
      <>
        <rect class="g-layer g-layer--3" x="14" y="12" width="36" height="12" rx="2" />
        <rect class="g-layer g-layer--2" x="14" y="26" width="36" height="12" rx="2" />
        <rect class="g-layer g-layer--1 g-fill-accent-rect" x="14" y="40" width="36" height="12" rx="2" />
        <circle class="g-fill-ink" cx="20" cy="18" r="2" />
        <circle class="g-fill-ink" cx="20" cy="32" r="2" />
      </>
    )
  }
  {
    name === 'commerce' && (
      <>
        <path class="g-stroke" d="M14 24h36l-3 28H17z" />
        <path class="g-stroke g-handlebar" d="M24 24v-4a8 8 0 0 1 16 0v4" />
        <g class="g-tag">
          <circle class="g-fill-accent" cx="46" cy="44" r="8" />
          <path class="g-thin-light" d="M43 44h6M46 41v6" />
        </g>
      </>
    )
  }
  {
    name === 'redesign' && (
      <>
        <rect class="g-thin g-frame g-frame--old" x="8" y="14" width="30" height="24" rx="2" />
        <rect class="g-stroke g-frame g-frame--new" x="24" y="26" width="32" height="24" rx="2" />
        <g class="g-cycle">
          <path class="g-stroke-accent" d="M44 10a10 10 0 0 1 10 10" />
          <path class="g-stroke-accent" d="M51 20h3.2v-3.2" />
        </g>
      </>
    )
  }
  {
    name === 'care' && (
      <>
        <path class="g-stroke" d="M10 44a22 22 0 0 1 44 0" />
        <path class="g-thin" d="M16 36l3 2M32 22v4M48 36l-3 2" />
        <g class="g-needle">
          <path class="g-stroke-accent" d="M32 44 44 30" />
        </g>
        <circle class="g-fill-ink" cx="32" cy="44" r="4" />
      </>
    )
  }
</svg>

<style>
  .glyph {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .glyph :global(*) {
    transition: transform 0.7s var(--ease-out), opacity 0.4s var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
  }

  .glyph :global(.g-stroke) {
    fill: none;
    stroke: var(--c-ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .glyph :global(.g-stroke-accent) {
    fill: none;
    stroke: var(--c-accent);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .glyph :global(.g-thin) {
    fill: none;
    stroke: var(--c-ink);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .glyph :global(.g-thin-light) {
    fill: none;
    stroke: var(--c-ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .glyph :global(.g-fill-ink) {
    fill: var(--c-ink);
  }

  .glyph :global(.g-fill-accent) {
    fill: var(--c-accent);
  }

  .glyph :global(.g-layer) {
    fill: var(--c-bg-raised);
    stroke: var(--c-ink);
    stroke-width: 2;
  }

  .glyph :global(.g-fill-accent-rect) {
    fill: var(--c-accent);
  }

  /* Hover choreography — triggered by the parent row */
  :global(.service:hover) .glyph--design :global(.g-knob--a) {
    transform: translate(-4px, -6px);
  }

  :global(.service:hover) .glyph--design :global(.g-knob--b) {
    transform: translate(4px, 6px);
  }

  :global(.service:hover) .glyph--develop :global(.g-left) {
    transform: translateX(-4px);
  }

  :global(.service:hover) .glyph--develop :global(.g-right) {
    transform: translateX(4px);
  }

  :global(.service:hover) .glyph--develop :global(.g-caret) {
    animation: blink 0.8s steps(1) infinite;
  }

  :global(.service:hover) .glyph--wordpress :global(.g-layer--3) {
    transform: translate(6px, -4px) rotate(4deg);
  }

  :global(.service:hover) .glyph--wordpress :global(.g-layer--1) {
    transform: translate(-6px, 4px) rotate(-4deg);
  }

  .glyph--commerce :global(.g-tag) {
    transform-origin: 46px 36px;
    transform-box: view-box;
  }

  :global(.service:hover) .glyph--commerce :global(.g-tag) {
    transform: rotate(-24deg);
  }

  :global(.service:hover) .glyph--commerce :global(.g-handlebar) {
    transform: translateY(-3px);
  }

  :global(.service:hover) .glyph--redesign :global(.g-frame--old) {
    opacity: 0.25;
    transform: translate(-3px, -3px);
  }

  :global(.service:hover) .glyph--redesign :global(.g-frame--new) {
    transform: translate(-6px, -4px);
  }

  .glyph--redesign :global(.g-cycle) {
    transform-origin: 44px 20px;
    transform-box: view-box;
  }

  :global(.service:hover) .glyph--redesign :global(.g-cycle) {
    transform: rotate(200deg);
  }

  .glyph--care :global(.g-needle) {
    transform-origin: 32px 44px;
    transform-box: view-box;
    transform: rotate(-80deg);
  }

  :global(.service:hover) .glyph--care :global(.g-needle) {
    transform: rotate(0deg);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
