---
import Button from '../Button.astro';
import { projectMailto, site } from '../../data/site';

const star = 'M20 0c1.6 10.2 9.8 18.4 20 20-10.2 1.6-18.4 9.8-20 20-1.6-10.2-9.8-18.4-20-20C10.2 18.4 18.4 10.2 20 0z';
---

<section class="section cta" id="contact" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__panel" data-cta>
      <div class="cta__art" aria-hidden="true">
        <span class="cta__blob cta__blob--a"></span>
        <span class="cta__blob cta__blob--b"></span>
        <svg class="cta__burst" viewBox="0 0 200 200" data-cta-burst>
          {
            Array.from({ length: 12 }).map((_, i) => (
              <rect x="97" y="8" width="6" height="60" rx="3" transform={`rotate(${i * 30} 100 100)`} />
            ))
          }
          <circle cx="100" cy="100" r="22"></circle>
        </svg>
        <svg class="cta__star cta__star--1" viewBox="0 0 40 40"><path d={star}></path></svg>
        <svg class="cta__star cta__star--2" viewBox="0 0 40 40"><path d={star}></path></svg>
      </div>

      <p class="eyebrow cta__eyebrow" data-reveal>Start a project</p>
      <h2 class="cta__title" id="cta-title" data-split>
        Have a project in mind? <span class="cta__em">Let's make it happen.</span>
      </h2>

      <div class="cta__actions" data-reveal>
        <Button href={projectMailto} size="lg" magnetic>Start Your Project</Button>
        <p class="cta__alt">
          or write to us at
          <a href={projectMailto}>{site.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: calc(var(--section-y) * 0.9);
  }

  .cta__panel {
    position: relative;
    isolation: isolate;
    padding: clamp(3rem, 8vw, 8rem) clamp(1.5rem, 6vw, 6rem);
    border-radius: clamp(1.4rem, 3vw, 2.6rem);
    background: linear-gradient(135deg, var(--c-peach) 0%, #ffe7d4 38%, var(--c-butter) 100%);
    overflow: hidden;
  }

  .cta__art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .cta__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(50px);
  }

  .cta__blob--a {
    width: 40vw;
    height: 40vw;
    max-width: 560px;
    max-height: 560px;
    right: -8%;
    bottom: -30%;
    background: var(--c-accent);
    opacity: 0.45;
    animation: cta-drift 14s var(--ease-in-out) infinite alternate;
  }

  .cta__blob--b {
    width: 30vw;
    height: 30vw;
    max-width: 420px;
    max-height: 420px;
    left: -6%;
    top: -20%;
    background: var(--c-mint);
    opacity: 0.9;
    animation: cta-drift 18s var(--ease-in-out) infinite alternate-reverse;
  }

  @keyframes cta-drift {
    to {
      transform: translate3d(-10%, -8%, 0) scale(1.15);
    }
  }

  .cta__burst {
    position: absolute;
    width: clamp(9rem, 20vw, 17rem);
    right: clamp(1.5rem, 6vw, 6rem);
    top: clamp(1.5rem, 5vw, 5rem);
    fill: var(--c-accent);
    animation: burst-spin 30s linear infinite;
  }

  .cta__burst circle {
    fill: var(--c-ink);
  }

  @keyframes burst-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .cta__star {
    position: absolute;
    fill: var(--c-ink);
    animation: cta-twinkle 3.6s var(--ease-in-out) infinite;
  }

  .cta__star--1 {
    width: 2rem;
    left: 46%;
    top: 12%;
  }

  .cta__star--2 {
    width: 1.3rem;
    right: 12%;
    bottom: 18%;
    fill: var(--c-bg-raised);
    animation-delay: -1.8s;
  }

  @keyframes cta-twinkle {
    50% {
      transform: scale(0.5) rotate(90deg);
    }
  }

  .cta__eyebrow {
    margin-bottom: 1.8rem;
  }

  .cta__eyebrow::before {
    background: var(--c-ink);
  }

  .cta__title {
    font-size: clamp(2.8rem, 1.2rem + 7.2vw, 9rem);
    font-weight: 650;
    line-height: 0.92;
    letter-spacing: -0.05em;
    max-width: 11ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .cta__em {
    color: var(--c-accent-deep);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem 2rem;
  }

  .cta__alt {
    color: var(--c-ink-2);
  }

  .cta__alt a {
    display: inline-block;
    margin-left: 0.25rem;
    font-weight: 600;
    color: var(--c-ink);
    background: linear-gradient(var(--c-ink), var(--c-ink)) 0 100% / 100% 1.5px no-repeat;
    transition: background-size 0.5s var(--ease-out);
  }

  .cta__alt a:hover {
    background-size: 0 1.5px;
    background-position: 100% 100%;
  }

  @media (max-width: 700px) {
    .cta__burst {
      width: 6.5rem;
      top: 1rem;
      right: 1rem;
      opacity: 0.9;
    }

    .cta__title {
      margin-top: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__blob,
    .cta__burst,
    .cta__star {
      animation: none;
    }
  }
</style>
